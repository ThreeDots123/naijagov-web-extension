# Copy to .env. Both have working local defaults, so an empty .env still builds.

# naijagov-api. Every AI call, every government rule, every explanation.
VITE_API_BASE=http://localhost:8787

# naijagov-web. Where the user creates the extension token.
VITE_WEB_BASE=http://localhost:3000

# Prefills the connect card so a demo connects in one click. Baked into the
# built bundle, readable by anyone with the extension. Leave empty otherwise.
VITE_DEMO_TOKEN=
